{
  "name": "case-escalation-automation",
  "private": true,
  "version": "1.0.0",
  "description": "Scheduled Apex batch that escalates open Cases breaching SLA thresholds",
  "scripts": {
    "lint": "eslint --no-error-on-unmatched-pattern \"**/{aura,lwc}/**/*.js\"",
    "prettier": "prettier --write \"force-app/**/*.{cls,trigger,xml,js,html,css,json}\" README.md \"*.json\" \"config/**/*.json\" eslint.config.js",
    "prettier:verify": "prettier --check \"force-app/**/*.{cls,trigger,xml,js,html,css,json}\" README.md \"*.json\" \"config/**/*.json\" eslint.config.js"
  },
  "devDependencies": {
    "@lwc/eslint-plugin-lwc": "^3.1.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@salesforce/eslint-config-lwc": "^4.0.0",
    "@salesforce/eslint-plugin-aura": "^3.0.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6"
  }
}
